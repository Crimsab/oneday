# LiteLLM / homelab AI proxy virtual key. Leave empty here; put real values in .env.
ONEDAY_LITELLM_API_KEY=

# Optional OpenAI-compatible image generation. If ONEDAY_IMAGEGEN_API_KEY is empty,
# the gateway falls back to ONEDAY_LITELLM_API_KEY. Base URL defaults to config.yaml
# ai.litellm.base_url, usually http://llm.example.com/v1.
ONEDAY_IMAGEGEN_API_KEY=
ONEDAY_IMAGEGEN_BASE_URL=
ONEDAY_IMAGEGEN_MODEL=gpt-image-2
ONEDAY_IMAGEGEN_AUTOGENERATE=true

# OpenRouter key used for generation fallback and RAG embeddings when selected.
ONEDAY_OPENROUTER_API_KEY=
