# Copy outside version control, for example:
#   cp compose.imagegen-bridge.env.example .env.imagegen-bridge
#   chmod 600 .env.imagegen-bridge
#
# The bearer is distinct from Codex OAuth. Generate a high-entropy value (for
# example, `openssl rand -hex 32`) and do not reuse or commit it.
IMAGEGEN_BRIDGE_BEARER_TOKEN=replace-with-a-random-secret

# A fixed release tag is intentional. Review upstream release notes before
# changing it; do not use `latest` for this integration.
IMAGEGEN_BRIDGE_IMAGE=ghcr.io/crimsab/imagegen-bridge:0.1.4@sha256:98650a1acfe405c9fea4c0df3cb71d754bd251febd89309d0a4cb4a04e0aa0d9

# Published only on host loopback by compose.imagegen-bridge.yaml.
IMAGEGEN_BRIDGE_PORT=8787
