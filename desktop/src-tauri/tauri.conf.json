{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneDay",
  "identifier": "dev.oneday.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "OneDay Desktop",
        "width": 860,
        "height": 860,
        "minWidth": 420,
        "minHeight": 620,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Play OneDay stories locally or connect to a server",
    "longDescription": "Run an isolated standalone OneDay profile with bundled sidecars, or connect securely to an existing OneDay server from Windows, Linux, or macOS.",
    "copyright": "Copyright OneDay contributors",
    "createUpdaterArtifacts": false,
    "resources": {
      "../gateway/web/dist/": "gateway/web/dist/"
    },
    "externalBin": [
      "binaries/oneday-v0.1.0",
      "binaries/oneday-gateway-v0.1.0"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "appimage": { "bundleMediaFramework": false },
      "deb": { "depends": [] }
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
