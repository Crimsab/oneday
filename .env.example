# Docker Compose
TZ=UTC
ONEDAY_PORT=8788
ONEDAY_IMAGE=ghcr.io/crimsab/oneday:latest

# Configure at least one narrative provider in config.yaml and add its key here.
ONEDAY_LITELLM_API_KEY=
ONEDAY_OPENROUTER_API_KEY=

# Optional visual generation. Leave blank to use config.yaml.
ONEDAY_IMAGEGEN_PROVIDER=
ONEDAY_IMAGEGEN_BASE_URL=
ONEDAY_IMAGEGEN_API_KEY=
ONEDAY_IMAGEGEN_OPENCLAW_URL=
ONEDAY_IMAGEGEN_BRIDGE_URL=
ONEDAY_IMAGEGEN_BRIDGE_TOKEN=
ONEDAY_IMAGEGEN_BRIDGE_PROVIDER=
ONEDAY_IMAGEGEN_BRIDGE_MAP_ICON_PROVIDER=
ONEDAY_IMAGEGEN_BRIDGE_FALLBACKS=
ONEDAY_IMAGEGEN_BRIDGE_FALLBACK_POLICY=
ONEDAY_IMAGEGEN_BRIDGE_COMPATIBILITY=
ONEDAY_IMAGEGEN_MODEL=
ONEDAY_IMAGEGEN_MAP_ICON_MODEL=

# Optional vendor-neutral OpenTelemetry trace export (OTLP/HTTP protobuf).
# Export stays disabled when no endpoint is set. ONEDAY_OTEL_ENABLED=false is
# an explicit kill switch even when shared OTEL_* variables exist.
ONEDAY_OTEL_ENABLED=
ONEDAY_DEPLOYMENT_ENVIRONMENT=
OTEL_SERVICE_NAME=oneday-gateway
OTEL_RESOURCE_ATTRIBUTES=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Example for Langfuse: Authorization=Basic <base64(public-key:secret-key)>,x-langfuse-ingestion-version=4
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=
OTEL_TRACES_SAMPLER_ARG=
