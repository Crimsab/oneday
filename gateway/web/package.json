{
  "name": "oneday-gateway-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src",
    "test:pwa": "bun run build && playwright test --config=playwright.pwa.config.ts",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run src --exclude src/commands.contract.test.ts --coverage --coverage.include='src/**/*.{ts,tsx}' --coverage.reporter=text --coverage.reporter=json-summary --coverage.reportsDirectory=coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "fflate": "^0.8.2",
    "flag-icons": "^7.5.0",
    "i18next": "^26.3.6",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
