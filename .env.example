# Docker Compose
TZ=UTC
ONEDAY_PORT=8788
ONEDAY_IMAGE=ghcr.io/crimsab/oneday:latest

# Browser access. `scripts/docker-init.sh` fills the bootstrap token in the
# untracked `.env`; never commit the generated value.
ONEDAY_GATEWAY_BOOTSTRAP_TOKEN=
ONEDAY_GATEWAY_ALLOWED_HOSTS=localhost:8788,127.0.0.1:8788,oneday-gateway:8788

# Configure at least one narrative provider in config.yaml and add its key here.
ONEDAY_LITELLM_API_KEY=
ONEDAY_OPENROUTER_API_KEY=

# Optional OpenAI-compatible cloud TTS key.
ONEDAY_TTS_API_KEY=

# Optional visual generation. Leave blank to use config.yaml.
ONEDAY_IMAGEGEN_PROVIDER=
ONEDAY_IMAGEGEN_MAP_ICON_PROVIDER=
ONEDAY_IMAGEGEN_BASE_URL=
ONEDAY_IMAGEGEN_API_KEY=
ONEDAY_IMAGEGEN_OPENCLAW_URL=
ONEDAY_IMAGEGEN_BRIDGE_URL=
ONEDAY_IMAGEGEN_BRIDGE_TOKEN=
ONEDAY_IMAGEGEN_BRIDGE_PROVIDER=
ONEDAY_IMAGEGEN_BRIDGE_MAP_ICON_PROVIDER=
ONEDAY_IMAGEGEN_BRIDGE_FALLBACKS=
ONEDAY_IMAGEGEN_BRIDGE_FALLBACK_POLICY=
ONEDAY_IMAGEGEN_BRIDGE_COMPATIBILITY=
ONEDAY_IMAGEGEN_MODEL=
ONEDAY_IMAGEGEN_MAP_ICON_MODEL=
ONEDAY_IMAGEGEN_SIZE=
ONEDAY_IMAGEGEN_LOCATION_SIZE=
ONEDAY_IMAGEGEN_CHARACTER_SIZE=
ONEDAY_IMAGEGEN_RESOLUTION=
ONEDAY_IMAGEGEN_LOCATION_RESOLUTION=
ONEDAY_IMAGEGEN_CHARACTER_RESOLUTION=
ONEDAY_IMAGEGEN_ASPECT_RATIO=
ONEDAY_IMAGEGEN_LOCATION_ASPECT_RATIO=
ONEDAY_IMAGEGEN_CHARACTER_ASPECT_RATIO=
ONEDAY_IMAGEGEN_QUALITY=
ONEDAY_IMAGEGEN_OUTPUT_FORMAT=
ONEDAY_IMAGEGEN_BACKGROUND=
ONEDAY_IMAGEGEN_TIMEOUT_SECONDS=
ONEDAY_IMAGEGEN_CONCURRENCY=
ONEDAY_IMAGEGEN_AUTOGENERATE=
ONEDAY_IMAGEGEN_APPEND_NEGATIVE_PROMPT=

# Direct image provider credentials. These never pass through imagegen-bridge.
ONEDAY_IMAGEGEN_OPENAI_BASE_URL=
ONEDAY_IMAGEGEN_OPENAI_API_KEY=
ONEDAY_IMAGEGEN_OPENAI_COMPATIBLE_BASE_URL=
ONEDAY_IMAGEGEN_OPENAI_COMPATIBLE_API_KEY=
ONEDAY_IMAGEGEN_GEMINI_BASE_URL=
ONEDAY_IMAGEGEN_GEMINI_API_KEY=
ONEDAY_IMAGEGEN_FAL_BASE_URL=
ONEDAY_IMAGEGEN_FAL_API_KEY=
ONEDAY_IMAGEGEN_REPLICATE_BASE_URL=
ONEDAY_IMAGEGEN_REPLICATE_API_TOKEN=
ONEDAY_IMAGEGEN_STABILITY_BASE_URL=
ONEDAY_IMAGEGEN_STABILITY_API_KEY=
ONEDAY_IMAGEGEN_AZURE_OPENAI_ENDPOINT=
ONEDAY_IMAGEGEN_AZURE_OPENAI_API_KEY=
ONEDAY_IMAGEGEN_AZURE_OPENAI_API_VERSION=

# Optional vendor-neutral OpenTelemetry trace export (OTLP/HTTP protobuf).
# Export stays disabled when no endpoint is set. ONEDAY_OTEL_ENABLED=false is
# an explicit kill switch even when shared OTEL_* variables exist.
ONEDAY_OTEL_ENABLED=
ONEDAY_DEPLOYMENT_ENVIRONMENT=
OTEL_SERVICE_NAME=oneday-gateway
OTEL_RESOURCE_ATTRIBUTES=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Example for Langfuse: Authorization=Basic <base64(public-key:secret-key)>,x-langfuse-ingestion-version=4
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=
OTEL_TRACES_SAMPLER_ARG=
